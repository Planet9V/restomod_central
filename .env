# ============================================
# RestoMod Central - Environment Configuration
# ============================================
# See .env.postgres.example for PostgreSQL configuration options

# Current Database (SQLite - for local development)
DATABASE_URL="./db/local.db"

# To switch to PostgreSQL:
# 1. Copy .env.postgres.example to .env
# 2. Update DATABASE_URL with your PostgreSQL connection string
# 3. Add API keys for OpenAI and Anthropic
# 4. Run migrations: npm run db:migrate
# 5. See docs/SETUP_POSTGRESQL.md for detailed instructions

# ============================================
# AI Services Configuration
# ============================================

# OpenAI API Key (for embedding generation)
# Get your API key from: https://platform.openai.com/api-keys
# Used by: server/services/ai/embeddingService.ts
OPENAI_API_KEY="your-openai-api-key-here"

# ============================================================================
# Restomod Central - Environment Variables Configuration
# ============================================================================
#
# SECURITY WARNING: This is a template file. Copy to .env and fill in actual values.
# NEVER commit .env to version control - it contains sensitive credentials!
#
# Instructions:
# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in all required values (marked as REQUIRED)
# 3. Generate strong secrets using: openssl rand -base64 32
# 4. Keep .env secure and never share it
#
# ============================================================================

# ----------------------------------------------------------------------------
# DATABASE CONFIGURATION (REQUIRED)
# ----------------------------------------------------------------------------

# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
# Example: postgresql://postgres:password@localhost:5432/restomod_central
# Production: Use connection pooling with ?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/restomod_central

# Optional: Direct URL for migrations (if different from DATABASE_URL)
# Some hosting providers require different URLs for connection pooling vs migrations
# DIRECT_URL=postgresql://postgres:password@localhost:5432/restomod_central

# ----------------------------------------------------------------------------
# AUTHENTICATION & SECURITY (REQUIRED)
# ----------------------------------------------------------------------------

# JWT Secret Key (REQUIRED)
# MUST be at least 32 characters long
# Generate with: openssl rand -base64 32
# Example: YourSuperSecretJWTKeyThatIsAtLeast32CharactersLong123456789
JWT_SECRET=

# Admin Account Configuration (REQUIRED for initial setup)
# These credentials will be used to create the initial admin account
# Password MUST contain: uppercase, lowercase, number, min 8 chars
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_USERNAME=admin

# Super Admin Email (REQUIRED)
# Only this email address will have superadmin privileges
# Can manage other admins, regenerate embeddings, and access analytics
SUPERADMIN_EMAIL=

# ----------------------------------------------------------------------------
# AI SERVICES (REQUIRED for AI features)
# ----------------------------------------------------------------------------

# OpenAI API Key (REQUIRED for embeddings and fallback chat)
# Get from: https://platform.openai.com/api-keys
# Used for: text-embedding-ada-002 (vector search), GPT-4 (fallback)
OPENAI_API_KEY=

# Anthropic API Key (REQUIRED for K.I.T.T. AI chat)
# Get from: https://console.anthropic.com/
# Used for: Claude 3.5 Sonnet (primary AI chat assistant)
ANTHROPIC_API_KEY=

# Google Gemini API Key (OPTIONAL - for multi-model support)
# Get from: https://makersuite.google.com/app/apikey
# Used for: Gemini Pro (alternative AI model)
# GOOGLE_AI_API_KEY=

# ----------------------------------------------------------------------------
# THIRD-PARTY SERVICES (OPTIONAL)
# ----------------------------------------------------------------------------

# PostHog Analytics (FREE tier available - 1M events/month)
# Get from: https://posthog.com/
# Used for: User analytics, feature flags, session replay
# Server-side (Node.js)
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
# Client-side (React - must start with VITE_)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com

# Sentry Error Tracking (FREE tier available - 5K errors/month)
# Get from: https://sentry.io/
# Used for: Error monitoring, performance tracking
# Server-side DSN
SENTRY_DSN=
# Client-side DSN (must start with VITE_)
VITE_SENTRY_DSN=
# Git commit hash for release tracking
GIT_COMMIT=
VITE_GIT_COMMIT=

# Firecrawl API (for web scraping)
# Get from: https://firecrawl.dev/
# Used for: LLM-ready web scraping of car listings
# FIRECRAWL_API_KEY=

# Mapbox Access Token (FREE tier available - 100K requests/month)
# Get from: https://account.mapbox.com/
# Used for: Maps, geocoding, routing, isochrones
MAPBOX_ACCESS_TOKEN=
# Client-side (must start with VITE_)
VITE_MAPBOX_ACCESS_TOKEN=

# Cloudinary Image CDN (FREE tier available - 25GB storage, 25GB bandwidth)
# Get from: https://cloudinary.com/
# Used for: Professional image delivery, optimization, transformations
# Server-side credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Client-side (React - must start with VITE_)
VITE_CLOUDINARY_CLOUD_NAME=

# NHTSA VIN Decoder (FREE - no API key required!)
# API URL: https://vpic.nhtsa.dot.gov/api/
# Used for: VIN decoding, vehicle data enrichment, fraud detection
# No configuration needed - built into @shaggytools/nhtsa-api-wrapper

# ----------------------------------------------------------------------------
# MCP SERVERS (Model Context Protocol)
# ----------------------------------------------------------------------------

# OpenCV MCP Server (FREE - self-hosted)
# Repository: https://github.com/GongRzhe/opencv-mcp-server
# Used for: Image quality control, enhancement, damage detection
OPENCV_MCP_ENABLED=false
OPENCV_MCP_URL=http://localhost:3001
OPENCV_MCP_API_KEY=
# Quality thresholds
OPENCV_BLUR_THRESHOLD=0.7
OPENCV_LIGHTING_THRESHOLD=0.6
OPENCV_MIN_RESOLUTION=1200
# Processing options
OPENCV_AUTO_ENHANCE=true
OPENCV_AUTO_BLUR_PLATES=true

# PostgreSQL MCP Pro (FREE - self-hosted)
# Repository: https://github.com/crystaldba/postgres-mcp
# Used for: Query optimization, performance monitoring, index recommendations
POSTGRES_MCP_ENABLED=false
POSTGRES_MCP_URL=http://localhost:3002
POSTGRES_MCP_API_KEY=
# Performance monitoring
POSTGRES_MCP_SLOW_QUERY_THRESHOLD=1000
POSTGRES_MCP_AUTO_EXPLAIN=true
POSTGRES_MCP_AUTO_VACUUM_INSIGHTS=true
POSTGRES_MCP_READ_ONLY=false

# ----------------------------------------------------------------------------
# SEARCH & DISCOVERY
# ----------------------------------------------------------------------------

# Meilisearch API Key (if using hosted Meilisearch)
# Get from: https://cloud.meilisearch.com/
# Used for: Fast full-text search
# MEILISEARCH_HOST=http://localhost:7700
# MEILISEARCH_API_KEY=

# ----------------------------------------------------------------------------
# EMAIL CONFIGURATION (OPTIONAL - for password reset)
# ----------------------------------------------------------------------------

# SMTP Configuration for sending emails
# Examples: Gmail, SendGrid, AWS SES, Mailgun
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-app-specific-password
# EMAIL_FROM=noreply@restomodcentral.com

# SendGrid API Key (alternative to SMTP)
# SENDGRID_API_KEY=

# ----------------------------------------------------------------------------
# EXTERNAL DATA SOURCES (OPTIONAL)
# ----------------------------------------------------------------------------

# NHTSA VIN Decoder API (FREE - no key required)
# https://vpic.nhtsa.dot.gov/api/
# No configuration needed - public API

# eBay Motors API (OPTIONAL - for scraping car listings)
# Get from: https://developer.ebay.com/
# Free tier: 5,000 calls/day
# Used for: Classic car listings from eBay Motors
EBAY_APP_ID=
# EBAY_CERT_ID=
# EBAY_DEV_ID=

# Eventbrite API (OPTIONAL - for scraping automotive events)
# Get from: https://www.eventbrite.com/platform/api
# Free tier: 1,000 requests/hour
# Used for: Car shows, auctions, and automotive events
EVENTBRITE_OAUTH_TOKEN=

# Bring a Trailer API/Scraper (OPTIONAL)
# No official API - requires web scraping with proper rate limiting

# ----------------------------------------------------------------------------
# SERVER CONFIGURATION
# ----------------------------------------------------------------------------

# Node Environment (development, production, test)
NODE_ENV=development

# Server Port (default: 5000)
PORT=5000

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:5000

# API Base URL
API_URL=http://localhost:5000/api

# Session Secret (for express-session)
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# ----------------------------------------------------------------------------
# RATE LIMITING
# ----------------------------------------------------------------------------

# Rate limit tiers (requests per minute)
RATE_LIMIT_ANONYMOUS=100
RATE_LIMIT_PREMIUM=500
RATE_LIMIT_ADMIN=1000

# AI Chat rate limits (requests per hour)
CHAT_RATE_LIMIT_ANONYMOUS=10
CHAT_RATE_LIMIT_PREMIUM=50
CHAT_RATE_LIMIT_ADMIN=200

# ----------------------------------------------------------------------------
# FEATURE FLAGS
# ----------------------------------------------------------------------------

# Enable/disable specific features
ENABLE_AI_CHAT=true
ENABLE_VECTOR_SEARCH=true
ENABLE_ANALYTICS=true
ENABLE_SCRAPING=false
ENABLE_EMAIL=false

# ----------------------------------------------------------------------------
# LOGGING & DEBUGGING
# ----------------------------------------------------------------------------

# Log level: error, warn, info, debug
LOG_LEVEL=info

# Enable query logging
LOG_QUERIES=false

# Enable detailed error messages (disable in production)
DEBUG=false

# ----------------------------------------------------------------------------
# SCRAPING CONFIGURATION (OPTIONAL)
# ----------------------------------------------------------------------------

# Scraping schedule (cron format)
# Default: Daily at 2 AM
SCRAPING_SCHEDULE=0 2 * * *

# Max concurrent scraping jobs
SCRAPING_MAX_CONCURRENT=3

# Scraping timeout (milliseconds)
SCRAPING_TIMEOUT=30000

# User agent for web scraping
SCRAPING_USER_AGENT=Mozilla/5.0 (compatible; RestomodBot/1.0)

# Proxy configuration (if needed for scraping)
# HTTP_PROXY=http://proxy:8080
# HTTPS_PROXY=https://proxy:8080

# ----------------------------------------------------------------------------
# DEPLOYMENT (Production-specific)
# ----------------------------------------------------------------------------

# For Vercel deployment
# VERCEL_URL=your-app.vercel.app

# For Railway deployment
# RAILWAY_STATIC_URL=your-app.railway.app

# For AWS deployment
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# CDN URL (for static assets)
# CDN_URL=https://cdn.restomodcentral.com

# ----------------------------------------------------------------------------
# TESTING (Test environment only)
# ----------------------------------------------------------------------------

# Test database (separate from production)
# TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/restomod_test

# Disable external API calls in tests
# MOCK_EXTERNAL_APIS=true

# ----------------------------------------------------------------------------
# NOTES
# ----------------------------------------------------------------------------
#
# Required Variables (must be set):
# - DATABASE_URL
# - JWT_SECRET (min 32 chars)
# - ADMIN_EMAIL
# - ADMIN_PASSWORD
# - SUPERADMIN_EMAIL
# - OPENAI_API_KEY (for embeddings)
# - ANTHROPIC_API_KEY (for AI chat)
#
# Recommended for Production:
# - SENTRY_DSN (error tracking)
# - POSTHOG_API_KEY (analytics)
# - EMAIL_* (password reset)
# - SESSION_SECRET
#
# Optional Enhancements:
# - FIRECRAWL_API_KEY (better scraping)
# - MAPBOX_ACCESS_TOKEN (maps)
# - MEILISEARCH_* (faster search)
#
# Security Checklist:
# ✅ Use strong, unique passwords (min 12 chars)
# ✅ Generate cryptographic secrets with openssl
# ✅ Never commit .env to git
# ✅ Rotate secrets regularly
# ✅ Use different secrets for dev/staging/prod
# ✅ Enable SSL/TLS in production
# ✅ Set NODE_ENV=production in production
# ✅ Review and audit regularly
#
# ============================================================================

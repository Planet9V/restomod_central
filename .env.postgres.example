# ============================================
# RestoMod Central - PostgreSQL Configuration
# ============================================
# Copy this file to .env and update with your actual values

# ============================================
# PostgreSQL Configuration
# ============================================
# For Neon: postgresql://username:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
# For Supabase: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
# For Local: postgresql://user:password@localhost:5432/restomod_central
DATABASE_URL=postgresql://user:password@localhost:5432/restomod_central

# ============================================
# pgvector Configuration
# ============================================
# Enable vector search capabilities for semantic search
PGVECTOR_ENABLED=true

# Vector dimensions (OpenAI embeddings use 1536 dimensions)
VECTOR_DIMENSIONS=1536

# ============================================
# OpenAI Configuration
# ============================================
# Required for generating embeddings for semantic search
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Model for embeddings (default: text-embedding-3-small)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ============================================
# Anthropic Configuration
# ============================================
# Required for AI chat assistance feature
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Model for chat (default: claude-3-5-sonnet-20241022)
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ============================================
# Redis Configuration (Optional)
# ============================================
# For job queue and caching
# For Upstash: redis://default:[password]@[endpoint].upstash.io:6379
# For Local: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# Enable Redis caching
REDIS_ENABLED=false

# ============================================
# Environment Configuration
# ============================================
# development | production | test
NODE_ENV=development

# Server port
PORT=5000

# ============================================
# Application Settings
# ============================================
# Enable debug logging
DEBUG=false

# JWT secret for authentication (generate a secure random string)
JWT_SECRET=your-secret-key-here

# Session secret
SESSION_SECRET=your-session-secret-here

# ============================================
# Feature Flags
# ============================================
# Enable semantic search
ENABLE_SEMANTIC_SEARCH=true

# Enable AI chat
ENABLE_AI_CHAT=true

# Enable web scraping
ENABLE_SCRAPING=false

# ============================================
# Migration Settings
# ============================================
# Keep SQLite for backward compatibility during migration
SQLITE_DATABASE_URL=./db/local.db

# Enable dual database mode (both SQLite and PostgreSQL)
DUAL_DATABASE_MODE=false

# ============================================
# Rate Limiting
# ============================================
# OpenAI rate limit (requests per minute)
OPENAI_RATE_LIMIT=60

# Anthropic rate limit (requests per minute)
ANTHROPIC_RATE_LIMIT=50

# ============================================
# Logging
# ============================================
# Log level: error | warn | info | debug
LOG_LEVEL=info

# Log format: json | pretty
LOG_FORMAT=pretty
